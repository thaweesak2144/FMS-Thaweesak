# ══════════════════════════════════════════════════════════
# Production Environment Configuration Template
# ══════════════════════════════════════════════════════════
# คัดลอกไฟล์นี้เป็น .env.production ก่อนสั่งรัน Docker
# cp .env.production.example .env.production

# 1. Database Credentials (ใช้สำหรับ docker-compose db service)
DB_USER=postgres
DB_PASSWORD=Passw0rd!vibe
DB_NAME=ums_prod
DB_HOST_PORT=5433

# 2. NextAuth Secret (สร้างรหัสปลอดภัยด้วยคำสั่ง: openssl rand -base64 32)
AUTH_SECRET=generate_your_own_32_bytes_random_secret_here

# 3. Application URL (URL ที่ผู้ใช้จะเข้าถึง เช่น http://localhost:3010 หรือโดเมนจริง)
APP_URL=http://localhost:3010

# 4. Email / SMTP Configuration (เว้นว่าง = บันทึกลง log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Academic Platform <no-reply@yourdomain.com>

# 5. OAuth Credentials (ถ้ามี)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
